{
  "name": "sms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "src/db/schema.prisma"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "simulator": "node src/simulator/site-simulator.js",
    "prisma:generate": "prisma generate --schema src/db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/db/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema src/db/schema.prisma",
    "prisma:studio": "prisma studio --schema src/db/schema.prisma",
    "seed": "node src/db/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.1",
    "nodemailer": "^6.9.15",
    "socket.io": "^4.7.5",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "prisma": "^5.19.1"
  }
}
